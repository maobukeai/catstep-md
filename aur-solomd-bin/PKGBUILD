# Maintainer: maobukeai <dev@catstepmd.local>
# pkgver must match app/package.json — guarded by the satellite-version
# drift job in .github/workflows/ci.yml.
pkgname=solomd-bin
pkgver=1.0.6
pkgrel=1
pkgdesc='A lightweight Markdown and plain text editor built with Tauri 2'
arch=('x86_64')
url='https://github.com/maobukeai/catstep-md'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'fuse2')
optdepends=(
    'wl-clipboard: clipboard image support on Wayland'
    'xclip: clipboard image support on X11'
)
provides=('solomd')
conflicts=('solomd')
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}.AppImage::https://github.com/maobukeai/catstep-md/releases/download/v${pkgver}/CatstepMD_${pkgver}_amd64.AppImage"
        "solomd.desktop")
# Checksum of the v1.0.6 amd64 AppImage asset; re-run `updpkgsums` on every
# pkgver bump (the v4.11.13 hash that was here before pointed at a release
# whose assets no longer exist).
sha256sums=('2dc57356d230b170bb632e3e5e172fec17009b3b2a92a9474f769ecb231315dc'
            'SKIP')

prepare() {
    chmod +x "${pkgname}-${pkgver}.AppImage"
    "./${pkgname}-${pkgver}.AppImage" --appimage-extract 2>/dev/null || true
}

package() {
    # Install the AppImage binary
    install -Dm755 "${srcdir}/${pkgname}-${pkgver}.AppImage" \
        "${pkgdir}/opt/catstep/CatstepMD.AppImage"

    # Install extracted icon if available, otherwise skip
    if [ -d "${srcdir}/squashfs-root" ]; then
        find "${srcdir}/squashfs-root" -name "*.png" -path "*/128x128/*" \
            -exec install -Dm644 {} "${pkgdir}/usr/share/icons/hicolor/128x128/apps/solomd.png" \; 2>/dev/null || true
    fi

    # Install desktop file
    install -Dm644 "${srcdir}/solomd.desktop" \
        "${pkgdir}/usr/share/applications/solomd.desktop"

    # Create /usr/bin symlinks (catstep, catstepmd, and solomd for compat)
    install -dm755 "${pkgdir}/usr/bin"
    ln -sf /opt/catstep/CatstepMD.AppImage "${pkgdir}/usr/bin/catstep"
    ln -sf /opt/catstep/CatstepMD.AppImage "${pkgdir}/usr/bin/catstepmd"
    ln -sf /opt/catstep/CatstepMD.AppImage "${pkgdir}/usr/bin/solomd"
}
