const { heading, lead, wechatLabel, wechatHint, emailLabel, emailHint, discussionsLabel, discussionsHint } = STR;
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact__header">
      <h2>{heading}</h2>
      <p class="lead">{lead}</p>
    </div>

    <div class="contact__grid">
      <article class="contact__card">
        <div class="contact__card-body">
          <img
            src="/contact/contact_qr.webp"
            alt={wechatLabel}
            loading="lazy"
            width="220"
            height="220"
          />
          <div class="contact__card-meta">
            <h3>{wechatLabel}</h3>
            <p>{wechatHint}</p>
          </div>
        </div>
      </article>

      <article class="contact__card contact__card--email">
        <div class="contact__card-body">
          <div class="contact__icon-box" aria-hidden="true">✉️</div>
          <div class="contact__card-meta">
            <h3>
              <a href="mailto:2026958851@qq.com">
                {emailLabel}
              </a>
            </h3>
            <p>{emailHint}</p>
          </div>
        </div>
      </article>

      <article class="contact__card contact__card--discussions">
        <div class="contact__card-body">
          <div class="contact__icon-box" aria-hidden="true">💬</div>
          <div class="contact__card-meta">
            <h3>
              <a href="https://github.com/maobukeai/catstep-md/discussions" target="_blank" rel="noopener">
                {discussionsLabel} →
              </a>
            </h3>
            <p>{discussionsHint}</p>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 64px 0;
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
  }
  .contact__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .contact__header h2 {
    font-size: 1.6rem;
    margin: 0 0 12px;
  }
  .contact__header .lead {
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    max-width: 980px;
    margin: 0 auto;
  }
  .contact__card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px 22px 24px;
    display: flex;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .contact__card:hover {
    border-color: var(--accent);
  }
  .contact__card-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    text-align: center;
    width: 100%;
  }
  .contact__card-body img {
    width: 180px;
    height: 180px;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
    padding: 6px;
    border: 1px solid var(--border);
  }
  .contact__card-meta h3 {
    margin: 0 0 6px;
    font-size: 1rem;
    font-weight: 600;
  }
  .contact__card-meta h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .contact__card-meta h3 a:hover {
    color: var(--accent);
  }
  .contact__card-meta p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .contact__card--email,
  .contact__card--discussions {
    background: var(--bg);
  }
  .contact__icon-box {
    font-size: 56px;
    line-height: 1;
    width: 180px;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-faint);
  }
</style>
