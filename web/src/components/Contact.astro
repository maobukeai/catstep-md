    emailLabel: 'Correo electrónico',
    emailHint: '2026958851@qq.com · Sugerencias y comentarios bienvenidos.',
    discussionsLabel: 'GitHub Discussions',
    discussionsHint: 'Async, público, buscable — no se requiere DM.',
  },
