{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatstepMD",
  "version": "1.0.6",
  "identifier": "app.catstepmd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "bash ../scripts/build-mcp-sidecar.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "猫步 MD",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; media-src 'self' asset: http://asset.localhost blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; media-src 'self' asset: http://asset.localhost blob:; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$AUDIO/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "mainBinaryName": "CatstepMD",
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "license": "MIT",
    "publisher": "maobukeai",
    "homepage": "https://github.com/maobukeai/catstep-md",
    "shortDescription": "猫步 MD (Catstep MD) - 极简高能 Markdown 编辑器",
    "longDescription": "猫步 MD (Catstep MD) 是一款轻量、跨平台、无干扰的 Markdown 与纯文本编辑器。用猫步，写好每一篇 Markdown。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text",
        "description": "Plain text document",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "installer.nsh"
      },
      "wix": {
        "bannerPath": "windows/banner.bmp",
        "dialogImagePath": "windows/dialog.bmp"
      }
    },
    "resources": [
      "icons/file_icon.ico",
      "resources/dicts/en_US.aff",
      "resources/dicts/en_US.dic"
    ],
    "externalBin": [
      "binaries/catstep-mcp"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "content",
            "file"
          ]
        }
      ]
    }
  }
}
