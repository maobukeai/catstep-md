{
  "manifest_version": 2,
  "name": "猫步 MD 网页剪藏 (Catstep MD Clipper)",
  "version": "2.4.0",
  "description": "将当前网页、选中文本或链接一键保存到本地猫步 MD (Catstep MD) 知识库。仅本地运行，绝不上传数据。",
  "browser_specific_settings": {
    "gecko": {
      "id": "web-clipper@catstepmd.app",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "猫步 MD 网页剪藏",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "notifications",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "commands": {
    "clip-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Clip selection (or whole page if no selection)"
    },
    "save-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Save link to current page"
    }
  }
}
